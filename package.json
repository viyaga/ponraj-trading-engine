{
  "name": "ponraj-trading-engine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "build": "node --max-old-space-size=512 ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "restart": "node scripts/pm2-restart.js",
    "pm2:restart": "node scripts/pm2-restart.js",
    "pm2:stop": "pm2 delete ponraj-trading-engine || true",
    "pm2:logs": "pm2 logs ponraj-trading-engine"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "kiteconnect": "^5.0.1",
    "mongoose": "^9.0.0",
    "node-cron": "^4.2.1",
    "smartapi-javascript": "^1.0.27",
    "ws": "^8.21.3",
    "@types/ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}